# --- Server ---
PUBLIC_WS_URL=ws://192.168.1.10:8000/xiaozhi/v1/
# Token dùng chung cho dev. Production: cấp token riêng cho từng thiết bị (DEVICE_TOKENS)
DEVICE_TOKENS={"*": "dev-token-change-me"}

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
SYSTEM_PROMPT=Bạn là trợ lý giọng nói thân thiện của OhStem. Trả lời bằng tiếng Việt, ngắn gọn 1-3 câu, không dùng markdown, emoji hay ký hiệu đặc biệt vì câu trả lời sẽ được đọc thành giọng nói.

# --- STT ---
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
STT_LANGUAGE=vi

# --- TTS --- (viettel | edge)
TTS_PROVIDER=viettel
VIETTEL_TTS_TOKEN=
VIETTEL_TTS_VOICE=hn-quynhanh
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
